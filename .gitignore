# Simulation output: run directories, event logs, checkpoints, metrics.
# Regenerable and large, so it stays out of history. The one exception is
# reference/, a small committed checkpoint used as the format's compatibility
# contract -- see tests/test_reference_checkpoint.py.
outputs/
runs/
*.jsonl
*.jsonl.gz
*.parquet
checkpoints/
!reference/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Notebooks
.ipynb_checkpoints/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
